# ==============================================================================
# AutoForge / NexusOps - Environment Variables
# ==============================================================================
# Copy this file to .env before starting the stack:
#   cp .env.example .env
#
# All variables are consumed by compose.yaml and compose.prod.yaml.
# DO NOT commit real secrets or credentials to source control.
# ==============================================================================

# ---- Compose ----
# Uncomment the next line to run with production overrides:
#   COMPOSE_FILE=compose.yaml:compose.prod.yaml
# COMPOSE_PROJECT_NAME=nexusops

# ---- Traefik ----
# Dashboard is routed on traefik.${DOMAIN} (prod only).
DOMAIN=localhost
LE_EMAIL=admin@example.com
# TRAEFIK_DASHBOARD_PASSWORD: bcrypt hash for the dashboard basic auth.
# Generate with: htpasswd -nbB admin <password>   (escape $ as $$ for Compose)
# Example (do not use in production):
# TRAEFIK_DASHBOARD_PASSWORD=admin:$$2y$$05$$...
TRAEFIK_DASHBOARD_PASSWORD=
# Traefik API insecure mode (base: true for local HTTP dashboard; prod: false).
TRAEFIK_API_INSECURE=true

# ---- PostgreSQL ----
POSTGRES_DB=nexusops
POSTGRES_USER=nexusops
# POSTGRES_PASSWORD: generated by scripts/generate-secrets.sh (never hardcode).
POSTGRES_PASSWORD=
# OPS_WRITER_PASSWORD: password for the least-privilege ops_writer role.
OPS_WRITER_PASSWORD=

# ---- Redis ----
# REDIS_PASSWORD: password for Redis (requirepass).
REDIS_PASSWORD=

# ---- Qdrant ----
# QDRANT_API_KEY: API key required to call Qdrant (enabled via env).
QDRANT_API_KEY=

# ---- n8n ----
# N8N_HOST: public hostname Traefik routes to n8n (e.g. n8n.localhost).
N8N_HOST=n8n.localhost
# N8N_PROTOCOL: http (base) or https (prod).
N8N_PROTOCOL=http
# WEBHOOK_URL: public webhook URL used by n8n for redirect URLs.
WEBHOOK_URL=http://n8n.localhost/
# N8N_ENCRYPTION_KEY: generated by scripts/generate-secrets.sh (never hardcode).
# WARNING: back this up. Losing it makes encrypted credentials unrecoverable.
N8N_ENCRYPTION_KEY=
GENERIC_TIMEZONE=UTC

# ---- n8n queue mode ----
# EXECUTIONS_MODE: set to "queue" to run main / webhook processor / workers.
EXECUTIONS_MODE=queue
# WORKER_REPLICAS: number of n8n-worker containers (controls execution concurrency).
WORKER_REPLICAS=2
# OFFLOAD_MANUAL_EXECUTIONS_TO_WORKERS: run manual executions on workers, not main.
OFFLOAD_MANUAL_EXECUTIONS_TO_WORKERS=true
# QUEUE_BULL_REDIS_DB: Redis database index for the Bull queue.
QUEUE_BULL_REDIS_DB=0
# N8N_DEFAULT_BINARY_DATA_MODE: "database" required in queue mode (filesystem not supported).
N8N_DEFAULT_BINARY_DATA_MODE=database
# N8N_GRACEFUL_SHUTDOWN_TIMEOUT: seconds for workers to finish jobs before stopping.
N8N_GRACEFUL_SHUTDOWN_TIMEOUT=30

# ---- Backup ----
# BACKUP_AGE_RECIPIENT: age public key for encrypting backup artifacts.
# Generate with: age-keygen -o age-key.txt (keep private key OFFLINE, only put public key here)
BACKUP_AGE_RECIPIENT=
# BACKUP_CRON: cron schedule for automated backups (default daily 03:00 UTC).
BACKUP_CRON=0 3 * * *
# BACKUP_S3_ENABLED: enable offsite sync to S3-compatible storage (true/false).
BACKUP_S3_ENABLED=false
# BACKUP_S3_ENDPOINT: S3-compatible endpoint (e.g., https://s3.amazonaws.com).
BACKUP_S3_ENDPOINT=
# BACKUP_S3_BUCKET: bucket name for backup storage.
BACKUP_S3_BUCKET=
# BACKUP_S3_PREFIX: prefix/path within bucket.
BACKUP_S3_PREFIX=nexusops
# BACKUP_S3_ACCESS_KEY: access key for S3.
BACKUP_S3_ACCESS_KEY=
# BACKUP_S3_SECRET_KEY: secret key for S3.
BACKUP_S3_SECRET_KEY=
# BACKUP_S3_REGION: S3 region.
BACKUP_S3_REGION=us-east-1
# BACKUP_RETENTION_DAILY: keep daily backups for N days.
BACKUP_RETENTION_DAILY=7
# BACKUP_RETENTION_WEEKLY: keep weekly backups for N weeks.
BACKUP_RETENTION_WEEKLY=4
# BACKUP_RETENTION_MONTHLY: keep monthly backups for N months.
BACKUP_RETENTION_MONTHLY=6
# ALERT_TELEGRAM_BOT_TOKEN: Telegram bot token for backup notifications.
ALERT_TELEGRAM_BOT_TOKEN=
# ALERT_TELEGRAM_CHAT_ID: Telegram chat ID to send notifications to.
ALERT_TELEGRAM_CHAT_ID=
# BACKUP_HEARTBEAT_URL: healthchecks.io-style URL to ping on backup success.
BACKUP_HEARTBEAT_URL=

# ---- Error Handling / Resilience ----
# ALERT_DEDUPE_WINDOW_MS: deduplication window for error alerts (default 5 min = 300000ms).
ALERT_DEDUPE_WINDOW_MS=300000
# N8N_PUBLIC_URL: public URL for execution links in alerts (e.g., https://n8n.example.com).
N8N_PUBLIC_URL=
# DLQ_REPLAY_TOKEN: bearer token for DLQ replay webhook authentication.
DLQ_REPLAY_TOKEN=
# N8N_BOOTSTRAP_USER: n8n user for bootstrap API calls.
N8N_BOOTSTRAP_USER=admin
# N8N_BOOTSTRAP_PASSWORD: n8n password for bootstrap API calls.
N8N_BOOTSTRAP_PASSWORD=
# HEALTHCHECK_PING_URL: optional heartbeat URL for healthcheck_ping workflow.
HEALTHCHECK_PING_URL=

# ---- LLM Cost Tracking ----
# LLM_MONTHLY_BUDGET_USD: monthly budget in USD for LLM spend (0 = disabled).
LLM_MONTHLY_BUDGET_USD=0
# BUDGET_ENFORCE: if true, deactivates workflows tagged "llm-guarded" at 100% budget.
BUDGET_ENFORCE=false
# BUDGET_WARNING_THRESHOLD: warning alert at this fraction of budget (default 0.8 = 80%).
BUDGET_WARNING_THRESHOLD=0.8
# BUDGET_CRITICAL_THRESHOLD: critical alert at this fraction (default 1.0 = 100%).
BUDGET_CRITICAL_THRESHOLD=1.0
# N8N_API_KEY: API key for n8n (used by budget_guard to deactivate workflows).
N8N_API_KEY=
# N8N_PUBLIC_URL: public base URL for n8n API (e.g., https://n8n.example.com).
N8N_PUBLIC_URL=
# DEFAULT_LLM_PROVIDER: fallback provider for log_llm_usage if not in input.
DEFAULT_LLM_PROVIDER=openai
# DEFAULT_LLM_MODEL: fallback model for log_llm_usage if not in input.
DEFAULT_LLM_MODEL=gpt-4o-mini
