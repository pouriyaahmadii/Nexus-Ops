# ==============================================================================
# NexusOps - Environment Variables Template
# ==============================================================================
# Copy this file to .env before starting the stack, or run scripts/generate-secrets.sh:
#   cp .env.example .env
#   ./scripts/generate-secrets.sh
#
# DO NOT commit real secrets or credentials to source control.
# ==============================================================================

# Project Namespace
COMPOSE_PROJECT_NAME=nexusops

# Ingress & Networking (Traefik v3)
DOMAIN_NAME=nexusops.localhost
TRAEFIK_HTTP_PORT=8080
TRAEFIK_HTTPS_PORT=8443
QDRANT_PORT=6333

# Database (PostgreSQL 16) - Strictly Internal Docker Network
POSTGRES_USER=nexusops
POSTGRES_PASSWORD=replace_with_secure_postgres_password
POSTGRES_DB=nexusops

# Cache & Queue (Redis 7) - Strictly Internal Docker Network
REDIS_PASSWORD=replace_with_secure_redis_password

# Vector Database (Qdrant)
QDRANT_API_KEY=replace_with_secure_qdrant_api_key

# Automation Engine (n8n Queue Mode)
N8N_ENCRYPTION_KEY=replace_with_32_char_encryption_key
N8N_HOST=nexusops.localhost
N8N_PORT=5678
N8N_PROTOCOL=http
WEBHOOK_URL=http://nexusops.localhost:8080/
N8N_DIAGNOSTICS_ENABLED=false
N8N_PERSONALIZATION_ENABLED=false
