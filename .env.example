# ==============================================================================
# AutoForge / NexusOps - Environment Variables
# ==============================================================================
# Copy this file to .env before starting the stack:
#   cp .env.example .env
#
# All variables are consumed by compose.yaml and compose.prod.yaml.
# DO NOT commit real secrets or credentials to source control.
# ==============================================================================

# ---- Compose ----
# Uncomment the next line to run with production overrides:
#   COMPOSE_FILE=compose.yaml:compose.prod.yaml
# COMPOSE_PROJECT_NAME=nexusops

# ---- Traefik ----
# Dashboard is routed on traefik.${DOMAIN} (prod only).
DOMAIN=localhost
LE_EMAIL=admin@example.com
# TRAEFIK_DASHBOARD_PASSWORD: bcrypt hash for the dashboard basic auth.
# Generate with: htpasswd -nbB admin <password>   (escape $ as $$ for Compose)
# Example (do not use in production):
# TRAEFIK_DASHBOARD_PASSWORD=admin:$$2y$$05$$...
TRAEFIK_DASHBOARD_PASSWORD=
# Traefik API insecure mode (base: true for local HTTP dashboard; prod: false).
TRAEFIK_API_INSECURE=true

# ---- PostgreSQL ----
POSTGRES_DB=nexusops
POSTGRES_USER=nexusops
# POSTGRES_PASSWORD: generated by scripts/generate-secrets.sh (never hardcode).
POSTGRES_PASSWORD=
# OPS_WRITER_PASSWORD: password for the least-privilege ops_writer role.
OPS_WRITER_PASSWORD=

# ---- Redis ----
# REDIS_PASSWORD: password for Redis (requirepass).
REDIS_PASSWORD=

# ---- Qdrant ----
# QDRANT_API_KEY: API key required to call Qdrant (enabled via env).
QDRANT_API_KEY=

# ---- n8n ----
# N8N_HOST: public hostname Traefik routes to n8n (e.g. n8n.localhost).
N8N_HOST=n8n.localhost
# N8N_PROTOCOL: http (base) or https (prod).
N8N_PROTOCOL=http
# WEBHOOK_URL: public webhook URL used by n8n for redirect URLs.
WEBHOOK_URL=http://n8n.localhost/
# N8N_ENCRYPTION_KEY: generated by scripts/generate-secrets.sh (never hardcode).
# WARNING: back this up. Losing it makes encrypted credentials unrecoverable.
N8N_ENCRYPTION_KEY=
GENERIC_TIMEZONE=UTC

# ---- n8n queue mode ----
# EXECUTIONS_MODE: set to "queue" to run main / webhook processor / workers.
EXECUTIONS_MODE=queue
# WORKER_REPLICAS: number of n8n-worker containers (controls execution concurrency).
WORKER_REPLICAS=2
# OFFLOAD_MANUAL_EXECUTIONS_TO_WORKERS: run manual executions on workers, not main.
OFFLOAD_MANUAL_EXECUTIONS_TO_WORKERS=true
# QUEUE_BULL_REDIS_DB: Redis database index for the Bull queue.
QUEUE_BULL_REDIS_DB=0
# N8N_DEFAULT_BINARY_DATA_MODE: "database" required in queue mode (filesystem not supported).
N8N_DEFAULT_BINARY_DATA_MODE=database
# N8N_GRACEFUL_SHUTDOWN_TIMEOUT: seconds for workers to finish jobs before stopping.
N8N_GRACEFUL_SHUTDOWN_TIMEOUT=30
