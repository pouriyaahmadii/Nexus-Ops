        "conditions": {
          "string": [
            {
              "value1": "={{ $json.action }}",
              "operation": "equals",
              "value2": "list"
            }
          ]
        }
      },
      "id": "if-list",
      "name": "If List",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1.1,
      "position": [900, 300]
    },
    {
      "parameters": {
        "query": "SELECT id, created_at, workflow_id, workflow_name, execution_id, node_name, error_message, attempts, status FROM ops.dead_letters WHERE status = 'pending' ORDER BY created_at DESC LIMIT 50;",
        "options": {}
      },
      "id": "list-dlq",
      "name": "List Pending DLQ",
