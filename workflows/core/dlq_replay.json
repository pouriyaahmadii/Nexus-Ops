      "typeVersion": 1.1,
      "position": [2000, 300]
    },
    {
      "parameters": {
        "functionCode": "const item = $json[0];\n\n// Replay by calling the original workflow via webhook or n8n API\nconst baseUrl = $getEnv('N8N_PUBLIC_URL') || $getEnv('WEBHOOK_URL') || 'http://n8n.localhost';\nconst replayUrl = `${baseUrl}/webhook/${item.workflow_id}/replay`;\n\n// Or use n8n REST API to re-execute\nconst apiUrl = `${baseUrl}/api/v1/workflows/${item.workflow_id}/execute`;\n\nreturn [{\n  json: {\n    dlq_id: item.id,\n    workflow_id: item.workflow_id,\n    original_execution_id: item.execution_id,\n    payload: item.payload,\n    replay_url: replayUrl,\n    api_url: apiUrl\n  }\n}];"
      },
      "id": "prepare-replay",
      "name": "Prepare Replay",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1.1,
      "position": [2000, 400]
    },
    {
      "parameters": {
        "url": "={{ $json.api_url }}",
        "method": "POST",
        "jsonParameters": true,
        "options": {
          "timeout": 60000
        },
        "headerParametersJson": "={{ JSON.stringify({ 'Content-Type': 'application/json' }) }}",
        "bodyParametersJson": "={{ JSON.stringify({ workflowData: $json.payload }) }}"
      },
      "id": "execute-workflow",
      "name": "Execute Workflow",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [2220, 400]
    },
    {
      "parameters": {
        "query": "UPDATE ops.dead_letters SET status = 'replayed', replayed_at = NOW(), attempts = attempts + 1 WHERE id = $1;",
        "queryParameters": [
          {
            "parameter": "={{ $json.dlq_id }}"
          }
        ],
        "options": {}
      },
      "id": "mark-replayed",
