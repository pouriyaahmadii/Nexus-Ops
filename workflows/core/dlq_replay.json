{
  "name": "DLQ Replay",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "dlq/replay",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1.1,
      "position": [240, 300]
    },
    {
      "parameters": {
        "functionCode": "const authHeader = $json.headers?.authorization || $json.headers?.Authorization;\nconst expectedToken = $getEnv('DLQ_REPLAY_TOKEN');\n\nif (!expectedToken) {\n  return [{ json: { error: 'DLQ_REPLAY_TOKEN not configured', status: 500 } }];\n}\n\nif (!authHeader || !authHeader.startsWith('Bearer ')) {\n  return [{ json: { error: 'Missing or invalid Authorization header', status: 401 } }];\n}\n\nconst token = authHeader.slice(7);\nif (token !== expectedToken) {\n  return [{ json: { error: 'Invalid token', status: 403 } }];\n}\n\nconst dlqId = $json.body?.dlq_id;\nconst action = $json.body?.action || 'replay'; // 'replay' | 'list' | 'discard'\n\nreturn [{ json: { dlq_id: dlqId, action, authorized: true } }];"
      },
      "id": "auth-check",
      "name": "Auth Check",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1.1,
      "position": [460, 300]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.authorized }}",
              "operation": "true"
            }
          ]
        }
      },
      "id": "if-authorized",
      "name": "If Authorized",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1.1,
      "position": [680, 300]
    },
