          "respondJson": "={{ { success: true, correlation_id: $json.correlation_id, intent: $json.llm_intent, risk_level: $json.llm_risk_level, approval_status: $json.approval_status, outbox_status: $json.outbox_status, reply: $json.llm_reply, cost_usd: $json.total_cost_usd } }}"
        }
      },
      "id": "respond-success",
      "name": "Respond Success",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [3980, 300]
    }
